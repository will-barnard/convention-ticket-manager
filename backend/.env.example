# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@db:5432/convention_tickets

# Auth
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_IN=2y

PORT=3000

# Email Configuration - Resend (leave blank to disable)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Convention Tickets <noreply@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com

# Email Configuration - Gmail App Password (leave blank to disable)
# Generate an app password at https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Frontend URL for QR code links
FRONTEND_URL=http://localhost:8080

# Shopify Integration API Key
SHOPIFY_API_KEY=generate-a-secure-random-key
